--" # The built-in stubs

Generated by `scripts/embed_stubs.py` from `stubs/*.stub`: do not edit by hand.
--"

fun builtin_stubs() -> map<string, string>
  let stubs: map<string, string> = {}
  stubs["command"] = [
    "-- `\{\{kebab\}\}`: a command of the tool.",
    "import \"@std/cli.q\" as cli",
    "",
    "#[cli.Command(\"\{\{kebab\}\}\", \"Says what \{\{kebab\}\} does\")]",
    "fun \{\{name\}\}(console: cli.Console) -> int",
    "  console.line(\"\{\{kebab\}\}\")",
    "  0",
    "end",
  ].join("\n") + "\n"
  stubs["controller"] = [
    "-- \{\{Name\}\} controller: a function with a route annotation is a route.",
    "import \"@std/web/app.q\" as web",
    "",
    "#[web.Get(\"/\{\{route\}\}\")]",
    "fun \{\{name\}\}_index() -> string",
    "  \"\{\{Name\}\} list\"",
    "end",
    "",
    "#[web.Get(\"/\{\{route\}\}/:id\")]",
    "fun \{\{name\}\}_show(#[web.Path] id: int) -> string",
    "  \"\{\{Name\}\} \{id\}\"",
    "end",
  ].join("\n") + "\n"
  stubs["controller_test"] = [
    "-- Tests of the \{\{Name\}\} controller.",
    "import \"../app.q\" as site",
    "import \"@std/web/testing.q\" as testing",
    "",
    "fun test_\{\{name\}\}_index_answers()",
    "  testing.Client.new(site.build()).get(\"/\{\{route\}\}\").expect_status(200).expect_body_contains(\"\{\{Name\}\}\")",
    "end",
    "",
    "fun test_\{\{name\}\}_show_answers()",
    "  testing.Client.new(site.build()).get(\"/\{\{route\}\}/1\").expect_status(200)",
    "end",
  ].join("\n") + "\n"
  stubs["factory"] = [
    "-- Test data for the `\{\{table\}\}` table.",
    "import \"@std/web/seed.q\" as seed",
    "",
    "fun \{\{name\}\}_factory() -> seed.Factory",
    "  let factory = seed.Factory.table(\"\{\{table\}\}\")",
    "  factory.field(\"name\", fun(n: int) -> Json Json.string(\"\{\{Name\}\} \{n\}\") end)",
    "  factory",
    "end",
    "",
    "export \{\{name\}\}_factory",
  ].join("\n") + "\n"
  stubs["job"] = [
    "-- \{\{Name\}\}: work done later by a queue worker.",
    "-- Register it with `queue.handle<\{\{Name\}\}>(handle_\{\{name\}\})`, push it with `queue.push(\{\{Name\}\} \{ id: 1 \})`.",
    "struct \{\{Name\}\}",
    "  public id: int",
    "end",
    "",
    "--\" Does the job: `none` when it is done, a text saying why it failed (it is tried again later). --\"",
    "fun handle_\{\{name\}\}(job: \{\{Name\}\}) -> string?",
    "  none",
    "end",
    "",
    "export \{\{Name\}\}, handle_\{\{name\}\}",
  ].join("\n") + "\n"
  stubs["middleware"] = [
    "-- \{\{Name\}\} middleware: add it with `app.use(\{\{name\}\}())`.",
    "import \"@std/web/app.q\" as web",
    "",
    "fun \{\{name\}\}() -> web.Middleware",
    "  fun(req: Request, next: web.Handler) -> Response",
    "    next(req)",
    "  end",
    "end",
    "",
    "export \{\{name\}\}",
  ].join("\n") + "\n"
  stubs["migration"] = [
    "-- Creates the `\{\{table\}\}` table.",
    "import \"@std/web/migrate.q\" as mig",
    "",
    "fun migration() -> mig.Migration",
    "  mig.Migration \{",
    "    id: \"\{\{id\}\}\",",
    "    up: [\"CREATE TABLE \{\{table\}\} (id INTEGER PRIMARY KEY, name TEXT NOT NULL)\"],",
    "    down: [\"DROP TABLE \{\{table\}\}\"],",
    "  \}",
    "end",
    "",
    "export migration",
  ].join("\n") + "\n"
  stubs["migration_blank"] = [
    "-- \{\{Name\}\}: write the statements that change the schema, and the ones that undo them.",
    "import \"@std/web/migrate.q\" as mig",
    "",
    "fun migration() -> mig.Migration",
    "  mig.Migration \{ id: \"\{\{id\}\}\", up: [], down: [] \}",
    "end",
    "",
    "export migration",
  ].join("\n") + "\n"
  stubs["migrations_index"] = [
    "-- The migrations of the application. `kit make migration` adds each new one here.",
    "import \"@std/web/migrate.q\" as mig",
    "",
    "fun all() -> array<mig.Migration>",
    "  [",
    "  ]",
    "end",
    "",
    "export all",
  ].join("\n") + "\n"
  stubs["model"] = [
    "-- \{\{Name\}\}: a row of the `\{\{table\}\}` table, and the queries that read it.",
    "import \"@std/web/query.q\" as q",
    "",
    "struct \{\{Name\}\}",
    "  public id: int",
    "  public name: string",
    "end",
    "",
    "fun all_\{\{names\}\}(db: Db) -> Result<array<\{\{Name\}\}>, Error>",
    "  q.Query.table(\"\{\{table\}\}\").order_by(\"id\", \"asc\").all_as<\{\{Name\}\}>(db)",
    "end",
    "",
    "fun find_\{\{name\}\}(db: Db, id: int) -> Result<\{\{Name\}\}?, Error>",
    "  q.Query.table(\"\{\{table\}\}\").where(\"id\", \"=\", id).first_as<\{\{Name\}\}>(db)",
    "end",
    "",
    "export \{\{Name\}\}, all_\{\{names\}\}, find_\{\{name\}\}",
  ].join("\n") + "\n"
  stubs["policy"] = [
    "-- \{\{Name\}\} policy: who can do what. Replace `int` (the user) and `Json` (the item) by your own types.",
    "import \"@std/web/policy.q\" as policy",
    "",
    "fun \{\{name\}\}_policy() -> policy.Policy<int, Json>",
    "  let rules = policy.Policy<int, Json>.create()",
    "  rules.allow(\"view\", fun(user: int, item: Json) -> bool true end)",
    "  rules",
    "end",
    "",
    "export \{\{name\}\}_policy",
  ].join("\n") + "\n"
  stubs["provider"] = [
    "-- \{\{Name\}\}: a service of the application. The container finds the function by the type it returns.",
    "struct \{\{Name\}\}",
    "  public name: string",
    "end",
    "",
    "#[used]",
    "fun make_\{\{name\}\}() -> \{\{Name\}\}",
    "  \{\{Name\}\} \{ name: \"\{\{name\}\}\" \}",
    "end",
  ].join("\n") + "\n"
  stubs["resource"] = [
    "-- \{\{Name\}\} resource: the fields an API shows.",
    "import \"@std/web/resource.q\" as res",
    "",
    "fun \{\{name\}\}_resource() -> res.Resource",
    "  res.Resource.only([\"id\", \"name\"])",
    "end",
    "",
    "export \{\{name\}\}_resource",
  ].join("\n") + "\n"
  stubs["seeder"] = [
    "-- Fills the database with \{\{names\}\}: `db:seed --only \{\{name\}\}`.",
    "import \"@std/web/seed.q\" as seed",
    "import \"../factories/\{\{name\}\}.q\" as factories",
    "",
    "fun \{\{name\}\}_seeder() -> seed.Seeder",
    "  seed.Seeder \{",
    "    name: \"\{\{name\}\}\",",
    "    run: fun(db: Db) -> Result<bool, Error>",
    "      seed.done(factories.\{\{name\}\}_factory().create_many(db, 10))",
    "    end,",
    "  \}",
    "end",
    "",
    "export \{\{name\}\}_seeder",
  ].join("\n") + "\n"
  stubs["test"] = [
    "-- Tests of \{\{names\}\}.",
    "import \"../app.q\" as site",
    "import \"@std/web/testing.q\" as testing",
    "",
    "fun test_\{\{names\}\}_are_served()",
    "  testing.Client.new(site.build()).get(\"/\{\{route\}\}\").expect_status(200)",
    "end",
  ].join("\n") + "\n"
  stubs
end

export builtin_stubs
